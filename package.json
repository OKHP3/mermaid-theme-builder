{
  "name": "@workspace/mermaid-theme-builder",
  "version": "0.6.1",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/preinstall.mjs",
    "prepare": "simple-git-hooks",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "capture-screenshot": "node scripts/capture-screenshot.mjs",
    "check:source-refs": "node scripts/check-source-refs.mjs",
    "check:version-strings": "node scripts/check-version-strings.mjs",
    "check:technology-versions": "node scripts/check-technology-versions.mjs",
    "check:doc-truth": "node scripts/check-doc-truth.mjs",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.ts\" \"*.json\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.ts\" \"*.json\"",
    "lint": "tsc --noEmit"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && node scripts/check-source-refs.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,json,css}": "prettier --write"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-zenuml": "^0.2.3",
    "@napi-rs/canvas": "^1.0.3",
    "@playwright/test": "^1.62.1",
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.3",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "axe-core": "^4.12.1",
    "happy-dom": "^20.10.6",
    "lightningcss-win32-x64-msvc": "1.32.0",
    "lint-staged": "^17.0.8",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.5",
    "react": "catalog:",
    "react-dom": "catalog:",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "mermaid": "11.16.0"
  }
}
