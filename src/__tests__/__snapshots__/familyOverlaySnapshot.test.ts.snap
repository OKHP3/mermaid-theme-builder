exports[`stateDiagram snapshot — state-theme-lifecycle > palette "AskJamie" (id: askjamie) matches snapshot 1`] = `
"%%{init: {"theme": "base", "themeVariables": {"labelColor": "#2d6f7e", "altBackground": "#f6f2ee", "compositeBackground": "#e8f4f7", "compositeBorder": "#2d6f7e", "compositeTitleBackground": "#fdfbf7", "innerEndBackground": "#2d6f7e", "specialStateColor": "#2d6f7e", "transitionColor": "#2d6f7e", "transitionLabelColor": "#2d6f7e", "stateLabelColor": "#2d6f7e", "stateBkg": "#fdfbf7", "labelBackgroundColor": "#f6f2ee", "primaryColor": "#fdfbf7", "primaryTextColor": "#2e2b29", "primaryBorderColor": "#2d6f7e", "lineColor": "#2d6f7e", "secondaryColor": "#f6f2ee", "secondaryTextColor": "#2e2b29", "secondaryBorderColor": "#2d6f7e", "tertiaryColor": "#e1ecef", "tertiaryTextColor": "#2e2b29", "tertiaryBorderColor": "#2d6f7e", "textColor": "#2e2b29", "background": "#f6f2ee", "mainBkg": "#fdfbf7", "nodeBorder": "#2d6f7e", "clusterBkg": "#e8f4f7", "titleColor": "#2d6f7e", "edgeLabelBackground": "#f6f2ee", "fontFamily": "Open Sans, system-ui, sans-serif"}}}%%
stateDiagram-v2
    [*] --> Idle : App loads

    state Idle {
        [*] --> DefaultPreset
        DefaultPreset --> PresetSelected : User picks palette
    }

    state Editing {
        [*] --> ColorAdjustment
        ColorAdjustment --> ColorAdjustment : Change color value
        ColorAdjustment --> FontChange : Edit font family
        FontChange --> ColorAdjustment : Back to colors
    }

    state Preview {
        [*] --> Rendering
        Rendering --> Rendered : Success
        Rendering --> RenderError : Parse failure
        RenderError --> Rendering : Code corrected
    }

    state Export {
        [*] --> ChooseFormat
        ChooseFormat --> StyledCode : Copy code
        ChooseFormat --> Markdown : Export bootstrap
        ChooseFormat --> PromptScaffold : Export scaffold
    }

    Idle --> Editing : Edit colors
    Idle --> Preview : Paste diagram
    Editing --> Preview : Preview updates live
    Preview --> Export : User exports
    Export --> Idle : Start over
    Editing --> Idle : Reset palette

    note right of Editing
        All edits are local.
        No data leaves the browser.
    end note"
`;

